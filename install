#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR" && pwd)"

GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

run_step() {
	local name="$1"
	echo ""
	echo "──────────────────────────────────────────────"
	echo "  ${CYAN}▶ ${name}${RESET}"
	echo "──────────────────────────────────────────────"
	bash "$REPO_ROOT/scripts/$name"
	local status=$?
	if [ $status -ne 0 ]; then
		echo ""
		echo "  ${RED}✗ '$name' failed (exit $status).${RESET}"
		exit 1
	fi
	echo "  ${GREEN}✓ done${RESET}"
}

# ─────────────────────────────────────────────────────────────
# Flags: --help
# ─────────────────────────────────────────────────────────────
for arg in "$@"; do
	case "$arg" in
		--help|-h)
			echo "Usage: ./install"
			echo ""
			echo "  Installs Rift + JankyBorders + Ghostty with an niri-like"
			echo "  scrolling-strip layout (no flags currently)."
			exit 0
			;;
		-*)
			echo "Unknown option: $arg (run './install --help')" >&2
			exit 1
			;;
	esac
done

# Fresh install vs. upgrade of an existing setup
if command -v rift >/dev/null 2>&1; then
	MODE="upgrade"
else
	MODE="install"
fi

echo ""
echo "  ╔══════════════════════════════════════════════════════╗"
echo "  ║   Rift + JankyBorders + Ghostty installer            ║"
if [ "$MODE" = "upgrade" ]; then
	echo "  ║              niri-like macOS setup (upgrade)       ║"
else
	echo "  ║              niri-like macOS setup                 ║"
fi
echo "  ╚══════════════════════════════════════════════════════╝"

run_step install-deps
run_step configure-system
run_step install-ghostty
run_step install-rift
run_step install-borders
run_step install-helpers
run_step grant-permissions
run_step enable-services

echo ""
echo "  ${GREEN}══════════════════════════════════════════════${RESET}"
if [ "$MODE" = "upgrade" ]; then
	echo "  ${GREEN}  Upgrade complete — configs refreshed & services restarted${RESET}"
	echo "  ${GREEN}  (Rift, JankyBorders, Ghostty)${RESET}"
else
	echo "  ${GREEN}  Installation complete!${RESET}"
fi
echo "  ${GREEN}══════════════════════════════════════════════${RESET}"
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  ${YELLOW}⚠ No logout needed for this upgrade.${RESET}"
	echo "     (A logout is only required if you toggled 'Displays have separate Spaces'.)"
else
	echo "  ${YELLOW}⚠ A logout/login is required for this to take effect:${RESET}"
	echo "     - 'Displays have separate Spaces' enabled (Rift-recommended)"
fi
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  ${YELLOW}⚠ Running now:${RESET}"
else
	echo "  ${YELLOW}⚠ After the next login:${RESET}"
fi
echo "     - Rift tiles windows on a niri-style scrolling strip"
echo "     - Rift's native menu bar shows workspaces 1-9"
echo "     - JankyBorders draws a border around the focused window"
echo "     - Ghostty runs frameless (title bar hidden)"
echo "     - If accessibility grants failed above, grant them manually:"
echo "       System Settings → Privacy & Security → Accessibility"
echo ""
echo "  ${CYAN}Usage:${RESET}"
echo "     Cmd+Option+Arrows        move focus between windows"
echo "     3-finger swipe (←/→)     switch columns"
echo "     3-finger swipe (↑/↓)     switch workspaces"
echo "     Cmd+Option+Shift+Arrows  move windows"
echo "     Ctrl+Option+↑/↓          switch workspace (1-9, fixed)"
echo "     Ctrl+Option+Shift+↑/↓    move window to workspace"
echo "     Cmd+Option+W             grow/shrink the focused column"
echo "     Cmd+Option+V             toggle floating"
echo "     Cmd+Option+O             stack / unstack"
echo "     Cmd+Ctrl+Arrows          move focus/window between displays"
echo "     Cmd+Option+Shift+R       reload Rift config (hot reload also on)"
echo "     Cmd+Shift+?              show the shortcut cheat sheet"
echo ""
if [ "$MODE" = "upgrade" ]; then
	echo "  'Displays have separate Spaces' is already configured; no logout required."
else
	echo "  Log out now, then back in (Cmd+Shift+Q)."
fi