#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Install Paneru (Homebrew core formula — no tap needed)
# ─────────────────────────────────────────────────────────────
if command -v paneru >/dev/null 2>&1; then
	before="$(brew list --versions paneru 2>/dev/null | tr ' ' '\n' | tail -1 || true)"
	note "Paneru already installed (${before:-unknown}) — upgrading..."
	if brew upgrade paneru >/dev/null 2>&1; then
		after="$(brew list --versions paneru 2>/dev/null | tr ' ' '\n' | tail -1 || true)"
		if [ "$before" = "$after" ]; then
			ok "Paneru is at ${after:-current}"
		else
			ok "Paneru updated: ${before:-old} → ${after:-new}"
		fi
	else
		warn "Paneru upgrade failed (network?) — keeping ${before:-current}"
	fi
else
	note "Installing Paneru via Homebrew..."
	brew install paneru
	ok "Paneru installed"
fi

# ─────────────────────────────────────────────────────────────
# Version floor: < 0.5.0 lacks the event-tap watchdog (karinushka/paneru#350)
# that revives keybindings after fullscreen/workspace toggles
# ─────────────────────────────────────────────────────────────
version="$(paneru --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)"
case "${version:-0.0.0}" in
	0.5*|0.6*|0.7*|0.8*|0.9*|[1-9]*)
		ok "Paneru ${version} ≥ 0.5.0 (event-tap watchdog present)"
		;;
	*)
		warn "Paneru ${version:-unknown} is older than 0.5.0 — it lacks the event-tap watchdog"
		warn "that revives keybindings after fullscreen/space toggles. Run 'brew update && brew upgrade paneru'."
		;;
esac

# ─────────────────────────────────────────────────────────────
# Config
# ─────────────────────────────────────────────────────────────
mkdir -p ~/.config/paneru/lib

if [ -f ~/.config/paneru/init.lua ]; then
	note "Existing config found at ~/.config/paneru/init.lua — backing up"
	cp ~/.config/paneru/init.lua ~/.config/paneru/init.lua.bak
fi

cp "$REPO_ROOT/config/paneru/init.lua" ~/.config/paneru/init.lua
# init.lua requires lib/*.lua (log.lua, query.lua, displays.lua) — no
# per-file backup needed, these are overwritten fresh each run same as
# helpers/ scripts.
cp "$REPO_ROOT"/config/paneru/lib/*.lua ~/.config/paneru/lib/
ok "Paneru config installed to ~/.config/paneru/init.lua (+ lib/*.lua)"
note "Menu-bar workspace indicator is off (upstream event-tap starvation bug, karinushka/paneru#390);"
note "the popup still shows the active workspace. Re-enable after a Paneru release ships the fix."
note "Cmd+Shift+? opens the shortcut cheat sheet via the helper above."

# ─────────────────────────────────────────────────────────────
# launchd service (applies Accessibility before start)
# ─────────────────────────────────────────────────────────────
note "Installing Paneru launchd service..."
if [ -f "$HOME/Library/LaunchAgents/com.github.karinushka.paneru.plist" ]; then
	ok "Paneru launchd service already installed (reinstall refreshes the plist)"
else
	paneru install
	ok "Paneru service installed"
fi

warn "Paneru will be started by enable-services after permissions are granted."
echo "     (grant Accessibility to $(command -v paneru) to let it move windows)"