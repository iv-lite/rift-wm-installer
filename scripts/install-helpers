#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

CYAN=$'\033[0;36m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

# ─────────────────────────────────────────────────────────────
# Shortcut helpers: ~/.config/mac-scrolling-wm/helpers/
# ─────────────────────────────────────────────────────────────
HELPERS_DIR="$HOME/.config/mac-scrolling-wm/helpers"
APP_DIR="$HELPERS_DIR/mac-cheatsheet-viewer.app"
VIEWER_SRC="$HELPERS_DIR/mac-cheatsheet-viewer-src"
VIEWER_REPO="${MAC_WM_VIEWER_REPO:-iv-lite/mac-cheatsheet-viewer}"

mkdir -p "$HELPERS_DIR"
cp "$REPO_ROOT/helpers/generate-shortcuts-json" "$HELPERS_DIR/generate-shortcuts-json"
cp "$REPO_ROOT/helpers/display-shortcuts" "$HELPERS_DIR/display-shortcuts"
chmod +x "$HELPERS_DIR/generate-shortcuts-json" "$HELPERS_DIR/display-shortcuts"
ok "Helpers installed to $HELPERS_DIR (generate-shortcuts-json, display-shortcuts)"
# Multi-display focus/move has no helper here anymore: Rift has native
# directional display commands (focus_display / move_window_to_display in
# config/rift/config.toml), unlike Paneru which needed compiled Swift/CG
# helpers (display-geometry, mouse-display, move-display, focus-display) to
# work around its single-hop "next display" limitation.

# ─────────────────────────────────────────────────────────────
# mac-cheatsheet-viewer app (fetched on every run, overwrites the bundle)
# ─────────────────────────────────────────────────────────────
# The release to download is the newest tag in the GitHub release list (not
# the special "latest" endpoint, which can drift from the actual newest tag;
# prereleases are included, drafts excluded, releases without the .app.zip
# asset are skipped). MAC_WM_VIEWER_TAG pins an exact tag instead.
if [ -n "${MAC_WM_VIEWER_TAG:-}" ]; then
	RELEASE_SOURCE="https://api.github.com/repos/$VIEWER_REPO/releases/tags/$MAC_WM_VIEWER_TAG"
	RELEASE_LABEL="$VIEWER_REPO@$MAC_WM_VIEWER_TAG"
else
	RELEASE_SOURCE="https://api.github.com/repos/$VIEWER_REPO/releases?per_page=100"
	RELEASE_LABEL="$VIEWER_REPO (newest release in list)"
fi

# Fetch the pre-built app from a GitHub release (curl only, no gh).
fetch_release() {
	local zip_url tmp found app="$1"
	tmp="$(mktemp -d)"
	note "Fetching mac-cheatsheet-viewer release ($RELEASE_LABEL)..."
	zip_url="$(curl -fsSL "$RELEASE_SOURCE" \
		| grep -o '"browser_download_url": *"[^"]*\.app\.zip"' | head -1 | cut -d'"' -f4 || true)"
	if [ -z "$zip_url" ]; then
		note "No .app.zip asset on release ($RELEASE_LABEL)"
		rm -rf "$tmp"
		return 1
	fi
	note "Downloading $(basename "$zip_url")..."
	if ! curl -fsSL "$zip_url" -o "$tmp/app.zip"; then
		note "Download failed"
		rm -rf "$tmp"
		return 1
	fi
	note "Extracting app.zip..."
	if ! ditto -x -k --sequesterRsrc "$tmp/app.zip" "$tmp"; then
		note "Extraction failed"
		rm -rf "$tmp"
		return 1
	fi
	found="$(find "$tmp" -maxdepth 2 -name '*.app' -type d | head -1 || true)"
	if [ -z "$found" ]; then
		note "No .app bundle inside the release zip"
		rm -rf "$tmp"
		return 1
	fi
	rm -rf "$app"
	cp -R "$found" "$app"
	rm -rf "$tmp"
	ok "mac-cheatsheet-viewer.app installed to $APP_DIR (from GitHub release)"
	return 0
}

if fetch_release "$APP_DIR"; then
	note "Cmd+Shift+? will now open the shortcut cheat sheet."
	note "Regenerated JSON on every launch from ~/.config/rift/config.toml."
	exit 0
fi

# ─────────────────────────────────────────────────────────────
# Fallback: build the app locally from source (needs Rust + tauri-cli)
# ─────────────────────────────────────────────────────────────
warn "GitHub release fetch failed — falling back to a local source build."
LOCAL_SRC="$REPO_ROOT/../mac-cheatsheet-viewer"
if [ ! -d "$LOCAL_SRC/.git" ]; then
	warn "Local source not found at $LOCAL_SRC either."
	warn "Clone the repo to build it, or check your network and re-run."
	exit 1
fi

if [ -d "$VIEWER_SRC/.git" ]; then
	note "Updating mac-cheatsheet-viewer source (git pull --ff-only)..."
	git -C "$VIEWER_SRC" pull --ff-only
else
	note "Cloning mac-cheatsheet-viewer source ($LOCAL_SRC)..."
	rm -rf "$VIEWER_SRC"
	git clone "$LOCAL_SRC" "$VIEWER_SRC"
fi
ok "mac-cheatsheet-viewer source ready in $VIEWER_SRC"

note "Building mac-cheatsheet-viewer.app..."
if ! command -v cargo >/dev/null 2>&1; then
	note "Installing Rust toolchain via Homebrew..."
	brew install rust
	ok "Rust installed"
fi

if command -v tauri >/dev/null 2>&1; then
	TAURI="tauri"
elif command -v npx >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
	note "Installing prebuilt Tauri CLI (@tauri-apps/cli, matches the CI workflow)..."
	(cd "$VIEWER_SRC" && npm install -D @tauri-apps/cli@2)
	TAURI="npx tauri"
else
	note "Installing tauri-cli from source (this compiles for a few minutes)..."
	cargo install tauri-cli --locked
	TAURI="tauri"
fi
ok "Tauri CLI ready ($TAURI)"

note "Building web assets (frontend/build.sh → frontend/dist)..."
(cd "$VIEWER_SRC" && bash frontend/build.sh)
ok "Web assets built"

note "Building the app bundle (embeds the web assets)..."
(cd "$VIEWER_SRC" && $TAURI build --bundles app)
APP_BUILT="$(ls -d "$VIEWER_SRC"/target/release/bundle/macos/*.app 2>/dev/null | head -1 || true)"
if [ -z "$APP_BUILT" ]; then
	warn "Build finished but no .app was found under $VIEWER_SRC/target/release/bundle/macos/"
	warn "Copy the bundle into $HELPERS_DIR manually once it exists."
	exit 0
fi
rm -rf "$APP_DIR"
cp -R "$APP_BUILT" "$APP_DIR"
ok "mac-cheatsheet-viewer.app installed to $APP_DIR (from local build)"

note "Cmd+Shift+? (Rift) will now open the shortcut cheat sheet."
note "The viewer JSON is regenerated on every launch from ~/.config/rift/config.toml."