#!/bin/bash
# move-display — teleport the focused window onto another display (v3).
#
# Paneru can only move a window to a single fixed display ("other().next()"
# in its ECS), which cannot reach every monitor on a 3+ display setup. For
# those setups this helper does the physical relocation. It is invoked by
# config/paneru/init.lua (Cmd+Ctrl+Shift+arrows) and must be installed at
# $HOME/.config/mac-scrolling-wm/helpers/move-display.
#
# This helper does exactly one thing: use AppleScript/Accessibility to move
# the frontmost window's position onto the target display's corner and click
# it, so macOS (and so Paneru's active-display marker) switches to that
# display. The window keeps its current size in transit — floating,
# settling, verifying adoption, retrying, and the eventual resize to full
# width all now live in Lua (config/paneru/init.lua's settle_after_move),
# which can poll Paneru's own state in-process (paneru.query_active /
# query_json) instead of spawning a `paneru query state` + python3 pair for
# every check, which is what made the previous version of this script slow.
#
# Usage: move-display <app_name> <x> <y>
# <app_name> is the frontmost app to (re-)activate before teleporting, if it
# isn't already frontmost; <x> <y> is the target display's origin in CG
# coordinates. Lua already has both from paneru.query_active()/display_frame().
#
# Needs Accessibility access for System Events (one-time macOS prompt).
# paneru.exec swallows stdout/stderr, so every run is also logged.
set -euo pipefail

APP_NAME="$1"
TX="$2"
TY="$3"
DEFAULT_DIR="${MAC_WM_HELPERS_DIR:-$HOME/.config/mac-scrolling-wm/helpers}"
LOG="$DEFAULT_DIR/move-display.log"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >>"$LOG"; }
mkdir -p "$(dirname "$LOG")"
log "teleport app=$APP_NAME target=$TX,$TY"

frontmost_app() {
  osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null || true
}

# Re-activate the intended app first if focus drifted since Lua floated it.
if [ -n "$APP_NAME" ] && [ "$(frontmost_app)" != "$APP_NAME" ]; then
  osascript -e "tell application \"$APP_NAME\" to activate" 2>/dev/null || true
  sleep 0.15
fi

if ! osascript - "$TX" "$TY" <<'EOF'
on run argv
  set tx to item 1 of argv as number
  set ty to item 2 of argv as number
  tell application "System Events"
    set frontApp to name of first application process whose frontmost is true
    tell process frontApp
      if (count of windows) is 0 then
        error "no windows"
      end if
      set fw to front window
      set position of fw to {tx, ty}
      set {px, py} to position of fw
      set {pw, ph} to size of fw
      click at {px + pw / 2, py + ph / 2}
    end tell
  end tell
end run
EOF
then
  log "error: osascript teleport failed"
  exit 1
fi

log "done: teleported to $TX,$TY"
exit 0
