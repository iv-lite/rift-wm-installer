#!/bin/bash
# warp-pointer — move the cursor to an absolute (x, y) point.
#
# Used by config/paneru/init.lua to "focus" a display that has no windows:
# the cursor lands on the blank monitor's center (the same thing paneru's
# native `mouse nextdisplay` does), so the OS switches its active display and
# the next action targets that monitor.
#
# Usage: warp-pointer <x> <y>
# Installed at $HOME/.config/mac-scrolling-wm/helpers/warp-pointer.
set -euo pipefail

X="$1"
Y="$2"

exec swift -e '
import CoreGraphics
import Foundation

let x = Double(CommandLine.arguments[1])!
let y = Double(CommandLine.arguments[2])!
CGWarpMouseCursorPosition(CGPoint(x: x, y: y))
CGAssociateMouseAndMouseCursorPosition(1)
' "$X" "$Y"