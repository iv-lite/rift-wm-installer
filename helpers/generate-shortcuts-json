#!/usr/bin/env python3
"""generate-shortcuts-json — read the Paneru init.lua BINDINGS table and emit
the shortcut cheat-sheet JSON consumed by mac-cheatsheet-viewer.

The JSON goes to stdout by default; display-shortcuts writes it to
~/.config/paneru/cheatsheet.json and lets the viewer open it.

Python 3.9+ (no tomllib).
"""
import argparse
import json
import os
import re
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

CONFIG_CANDIDATES = [
    os.path.join(os.environ.get("HOME", ""), ".config", "paneru", "init.lua"),
    os.path.join(REPO_ROOT, "config", "paneru", "init.lua"),
]

BINDING_RE = re.compile(r'^\s*\["([a-z0-9_ ]+)"\]\s*=\s*"((?:[^"\\]|\\.)*)"\s*,?\s*(?:--.*)?$')

# paneru.bind("chord", function(ws) ... end) — function-bound shortcuts.
LUA_BIND_RE = re.compile(r'^\s*paneru\.bind\("((?:[^"\\]|\\.)*)"\s*,\s*(?:function\b|[\w_]+)')

# Ordered curated map: command string -> (category, action label).
# Unknown commands fall back to "Other" with a title-cased action.
CURATED = {
    "window focus west": ("Focus", "Focus window west"),
    "window focus east": ("Focus", "Focus window east"),
    "window focus north": ("Focus", "Focus window north"),
    "window focus south": ("Focus", "Focus window south"),
    "window swap west": ("Move", "Move window west"),
    "window swap east": ("Move", "Move window east"),
    "window swap north": ("Move", "Move window north"),
    "window swap south": ("Move", "Move window south"),
    "window resize": ("Column width", "Cycle column width"),
    "window shrink": ("Column width", "Shrink column to next preset"),
    "window fullwidth": ("Column width", "Full-width page"),
    "window virtual north": ("Workspaces", "Previous workspace row"),
    "window virtual south": ("Workspaces", "Next workspace row"),
    "window virtualmove north": ("Workspaces", "Move window, follow to previous row"),
    "window virtualmove south": ("Workspaces", "Move window, follow to next row"),
    "window focus managed": ("Workspaces", "Cycle managed windows"),
    "cmd + ctrl - leftarrow": ("Displays", "Focus previous display"),
    "cmd + ctrl - rightarrow": ("Displays", "Focus next display"),
    "cmd + ctrl + shift - leftarrow": ("Displays", "Move window to previous display"),
    "cmd + ctrl + shift - rightarrow": ("Displays", "Move window to next display"),
    "cmd + shift - slash": ("Cheat sheet", "Show this cheat sheet"),
    "mouse nextdisplay": ("Displays", "Warp mouse to next display"),
    "window manage": ("Window state", "Toggle tiled / floating"),
    "window stack": ("Window state", "Stack into neighbour column"),
    "window unstack": ("Window state", "Pull out of a stack"),
    "window center": ("Window state", "Center window"),
    "window snap": ("Window state", "Snap window into view"),
    "window equalize": ("Window state", "Equalize columns"),
    "window balance": ("Window state", "Balance columns to focused width"),
    "window copyrule": ("Window state", "Copy window rule"),
    "restart": ("Misc", "Restart Paneru"),
    "quit": ("Misc", "Quit Paneru"),
}

MODS = {
    "cmd": "Cmd",
    "ctrl": "Ctrl",
    "alt": "Option",
    "option": "Option",
    "shift": "Shift",
}

KEYS = {
    "leftarrow": "\u2190",
    "rightarrow": "\u2192",
    "uparrow": "\u2191",
    "downarrow": "\u2193",
    "space": "Space",
    "tab": "Tab",
    "escape": "Esc",
    "return": "Return",
    "enter": "Enter",
    "del": "Delete",
    "backspace": "Backspace",
    "slash": "/",
    "period": ".",
    "comma": ",",
    "semicolon": ";",
    "apostrophe": "'",
    "plus": "+",
    "minus": "-",
}


def humanize_chord(chord):
    """'cmd + alt + shift - leftarrow' -> 'Cmd+Option+Shift+\u2190'."""
    if " - " not in chord:
        return chord
    left, raw_key = chord.split(" - ", 1)
    tokens = [t.strip() for t in left.split(" + ")] if left else []
    key = raw_key.strip()
    mods = [MODS.get(t, t.capitalize()) for t in tokens if t]
    if key == "slash":
        label = "?" if "shift" in tokens else "/"
    else:
        label = KEYS.get(key, key.capitalize() if key else "")
    return "+".join(mods + [label])


def parse_bindings(text):
    bindings = []
    for line in text.splitlines():
        m = BINDING_RE.match(line)
        if m:
            bindings.append((m.group(1), m.group(2)))
            continue
        lm = LUA_BIND_RE.match(line)
        if lm:
            bindings.append((lm.group(1), lm.group(1)))
    return bindings


def build_groups(bindings):
    groups = {}
    for command, chord in bindings:
        entry = CURATED.get(command)
        category, action = entry if entry else ("Other", " ".join(w.capitalize() for w in command.split()))
        groups.setdefault(category, []).append(
            {"action": action, "keys": [humanize_chord(chord)]}
        )
    static = [
        ("Gestures", [
            {"action": "Swipe through windows", "keys": ["3-finger swipe \u2190/\u2192"]},
            {"action": "Switch workspace rows", "keys": ["3-finger swipe \u2191/\u2193"]},
            {"action": "Scroll the strip", "keys": ["Cmd+Option+scroll"]},
        ]),
    ]
    for name, items in static:
        groups[name] = items
    return [{"name": name, "items": groups[name]} for name in groups]


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--config", help="path to the Paneru init.lua (default: ~/.config/paneru/init.lua)")
    ap.add_argument("--output", help="write JSON to this file instead of stdout")
    args = ap.parse_args()

    config = args.config
    if not config:
        config = next((c for c in CONFIG_CANDIDATES if os.path.isfile(c)), None)
    if not config or not os.path.isfile(config):
        sys.exit("generate-shortcuts-json: cannot find config/paneru/init.lua (use --config)")

    with open(config, encoding="utf-8") as fh:
        text = fh.read()
    bindings = parse_bindings(text)
    if not bindings:
        sys.exit("generate-shortcuts-json: no bindings found in {}".format(config))

    sheet = {
        "app": "Paneru",
        "config_path": os.path.abspath(config),
        "groups": build_groups(bindings),
    }

    if args.output:
        with open(args.output, "w", encoding="utf-8") as fh:
            json.dump(sheet, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
    else:
        print(json.dumps(sheet, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()