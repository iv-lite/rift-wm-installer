#!/bin/bash
# mouse-display — print the id of whichever online display currently has the
# mouse pointer.
#
# Paneru's Lua `display_of` resolves a window's display by strip membership,
# so it can't tell you "which display am I on" when the display you're
# currently on has no windows at all — there's nothing to look up. The mouse
# pointer always has a position regardless of whether any window is there, so
# config/paneru/init.lua uses this (not the focused window) as the source of
# truth for "current display" when computing next/previous for both
# Cmd+Ctrl+←/→ (focus) and Cmd+Ctrl+Shift+←/→ (move).
#
# Output: a single display id (CGDirectDisplayID) on stdout.
# Installed at $HOME/.config/mac-scrolling-wm/helpers/mouse-display.
set -euo pipefail

exec swift -e '
import CoreGraphics
import Foundation

guard let event = CGEvent(source: nil) else { exit(1) }
let p = event.location

var count: UInt32 = 0
CGGetOnlineDisplayList(0, nil, &count)
var ids = [CGDirectDisplayID](repeating: 0, count: Int(count))
CGGetOnlineDisplayList(count, &ids, &count)

for id in ids {
  if CGDisplayBounds(id).contains(p) {
    print(id)
    exit(0)
  }
}
// Pointer sits exactly on a boundary/off any bounds (shouldnt normally
// happen for a valid on-screen position): fall back to the first display.
if let id = ids.first {
  print(id)
}
'
