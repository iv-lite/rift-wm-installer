#!/bin/bash
# JankyBorders config — matches the active-window border from the previous
# Paneru setup (`decorations.active.border` in the old config/paneru/init.lua).
# Loaded by the borders service from ~/.config/borders/bordersrc

options=(
	style=round
	width=4.0
	hidpi=on
	active_color=0xff343c4d
	inactive_color=0x00000000
)

borders "${options[@]}"
