#!/usr/bin/env bash
# Test workflow for the rift-wm-installer project. Runs the real ./install
# inside a fresh macOS guest VM and lets you verify Rift tiling +
# the native menu bar with Rift's indicators visually via screenshots.
#
# Host is auto-detected:
#   macOS (Apple Silicon) -> Tart hypervisor  (requires macOS 15+, Homebrew)
#   Linux x86_64          -> QEMU/KVM + OpenCore (requires TESTS_MACOS_DISK)
# All commands behave identically on both backends.
#
# Known limits:
#   - Single virtual display  -> multi-monitor bindings cannot be tested.
#   - Accessibility grants    -> may need one manual GUI grant in the guest.
#
# Structure:
#   tests/lib/common.sh         host detection + shared helpers (colors, SSH, lifecycle)
#   tests/lib/backend_tart.sh   Tart backend (macOS host)
#   tests/lib/backend_qemu.sh   QEMU/KVM backend (Linux x86_64 host)
#   tests/lib/commands.sh       per-subcommand implementations over the backend contract
#
# Usage: ./tests/preview {setup|up|install|access|login|check|shot|snapshot|restore|ssh|stop|delete|clean}
# Running with no command defaults to: install requirements -> setup -> boot the VM.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

source "$ROOT/tests/lib/common.sh"
source "$ROOT/tests/lib/commands.sh"

main() {
  if [ $# -eq 0 ]; then
    note "No command given — installing requirements and previewing the setup"
    ensure_deps
    cmd_setup
    cmd_up
    return 0
  fi
  case "$1" in
    -h|--help|help) usage;;
    setup)          cmd_setup;;
    clean)          cmd_clean;;
    up|install|access|login|check|shot|snapshot|restore|ssh|stop|delete)
      ensure_deps
      case "$1" in
        up)        cmd_up "${2:-}";;
        install)   cmd_install;;
        access)    cmd_access;;
        login)     cmd_login;;
        check)     cmd_check;;
        shot)      cmd_shot;;
        snapshot)  cmd_snapshot;;
        restore)   cmd_restore "${2:-bare}";;
        ssh)       cmd_ssh;;
        stop)      cmd_stop;;
        delete)    cmd_delete;;
      esac
      ;;
    *) die "unknown command '$1'"; usage;;
  esac
}

main "$@"