#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR" && pwd)"

GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
CYAN=$'\033[0;36m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

note() { echo "  ${CYAN}→ $*${RESET}"; }
ok()   { echo "  ${GREEN}✓ $*${RESET}"; }
warn() { echo "  ${YELLOW}⚠ $*${RESET}"; }

echo ""
echo "  ╔══════════════════════════════════════════════════╗"
echo "  ║          niri-like macOS setup — uninstall        ║"
echo "  ╚══════════════════════════════════════════════════╝"
echo ""
echo "  This will:"
echo "   • Stop/remove Rift + JankyBorders (plus legacy Paneru, rift-swipe,"
echo "     AeroSpace/AeroSpaceBar/Aegis if present)"
echo "   • Revoke Accessibility permissions"
echo "   • Move configs to ~/.config/backups (not deleted, incl. shortcut helpers)"
echo "   • Uninstall brew packages (you'll choose which to keep)"
echo "     rift, borders, tccutil-rs, ghostty"
echo "     (+ legacy paneru, aerospace, aerospacebar if still present)"
echo "   • Clean up legacy Aegis.app + its LaunchAgent/preferences (if present)"
echo "   • Untap repos no longer needed (acsandmann/tap, FelixKratz/formulae,"
echo "     nikitabobko/tap, rdrkr/tap, uinaf/tap)"
echo "   • Revert system defaults (show the native menu bar again)"
echo ""
read -r -p "  Continue? [y/N] " answer
if [ "${answer:-n}" != "y" ] && [ "${answer:-n}" != "Y" ]; then
	echo ""
	echo "  Aborted. Nothing was changed."
	exit 0
fi

# ─────────────────────────────────────────────────────────────
# 1. Stop & remove services
# ─────────────────────────────────────────────────────────────
echo ""
note "Stopping services..."

if command -v rift >/dev/null 2>&1; then
	if rift service stop >/dev/null 2>&1; then
		ok "Rift stopped"
	fi
	if rift service uninstall >/dev/null 2>&1; then
		ok "Rift service removed"
	fi
fi

# JankyBorders
if command -v borders >/dev/null 2>&1; then
	brew services stop borders >/dev/null 2>&1 || true
	ok "JankyBorders service stopped"
fi

# Legacy: rift-swipe LaunchAgent (binary lived in ~/.config/rift, removed below)
if [ -f ~/Library/LaunchAgents/io.rift-swipe.plist ]; then
	launchctl bootout "gui/$(id -u)/io.rift-swipe" >/dev/null 2>&1 || true
	rm -f ~/Library/LaunchAgents/io.rift-swipe.plist
	ok "rift-swipe LaunchAgent stopped + removed (legacy)"
fi

# Legacy: Paneru
if command -v paneru >/dev/null 2>&1; then
	if paneru stop >/dev/null 2>&1; then
		ok "Legacy Paneru stopped"
	fi
	if paneru uninstall >/dev/null 2>&1; then
		ok "Legacy Paneru service removed"
	fi
	if command -v paneru >/dev/null 2>&1; then
		paneru uninstall-app >/dev/null 2>&1 || true
		ok "Legacy Paneru app launcher removed (if present)"
	fi
fi
# Belt-and-braces in case the CLI wasn't available to clean up after itself
if [ -f ~/Library/LaunchAgents/com.github.karinushka.paneru.plist ]; then
	launchctl bootout "gui/$(id -u)/com.github.karinushka.paneru" >/dev/null 2>&1 || true
	rm -f ~/Library/LaunchAgents/com.github.karinushka.paneru.plist
	ok "Legacy Paneru LaunchAgent stopped + removed (fallback)"
fi
if [ -d "$HOME/Applications/Paneru.app" ]; then
	rm -rf "$HOME/Applications/Paneru.app"
	ok "Removed legacy ~/Applications/Paneru.app (fallback)"
fi

if [ -d /Applications/AeroSpace.app ] && pgrep -q -f "AeroSpace.app" 2>/dev/null; then
	if osascript -e 'tell application "AeroSpace" to quit' >/dev/null 2>&1; then
		ok "AeroSpace quit (legacy)"
	fi
fi

if [ -d /Applications/AeroSpaceBar.app ] && pgrep -q -f "AeroSpaceBar.app" 2>/dev/null; then
	if osascript -e 'tell application "AeroSpaceBar" to quit' >/dev/null 2>&1; then
		ok "AeroSpaceBar quit (legacy)"
	fi
fi

# Aegis: stop + remove LaunchAgent
if [ -f ~/Library/LaunchAgents/com.aegis.Aegis.plist ]; then
	launchctl unload ~/Library/LaunchAgents/com.aegis.Aegis.plist >/dev/null 2>&1 || true
	rm -f ~/Library/LaunchAgents/com.aegis.Aegis.plist
	ok "Aegis LaunchAgent stopped + removed"
fi
if pgrep -q -x Aegis 2>/dev/null; then
	osascript -e 'tell application "Aegis" to quit' >/dev/null 2>&1 || pkill -x Aegis 2>/dev/null || true
	ok "Aegis quit"
fi

# ─────────────────────────────────────────────────────────────
# 2. Revoke Accessibility permissions
# ─────────────────────────────────────────────────────────────
echo ""
note "Revoking Accessibility permissions..."
if command -v tccutil-rs >/dev/null 2>&1; then
	for bin in "$(command -v rift 2>/dev/null || true)" \
	           "$(command -v paneru 2>/dev/null || true)" \
	           "/Applications/AeroSpace.app/Contents/MacOS/AeroSpace" \
	           "$(command -v borders 2>/dev/null || true)" \
	           "$HOME/.config/rift/bin/rift-swipe" \
	           "/Applications/Aegis.app/Contents/MacOS/Aegis"; do
		if [ -n "$bin" ]; then
			tccutil-rs revoke --user Accessibility "$bin" >/dev/null 2>&1 || true
		fi
	done
	ok "Accessibility grants revoked (best-effort)"
else
	warn "tccutil-rs not installed — skip revoking (also fine)"
fi

# ─────────────────────────────────────────────────────────────
# 3. Remove configs (moved to backup, not destroyed)
# ─────────────────────────────────────────────────────────────
echo ""
note "Removing configs..."

BACKUP_DIR="$HOME/.config/backups/uninstall-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP_DIR"

if [ -f ~/.aerospace.toml ] || [ -f ~/.aerospace.toml.bak ]; then
	warn "~/.aerospace.toml* exists outside ~/.config — leaving untouched (not ours to remove)"
fi

for dir in ~/.config/paneru ~/.config/mac-scrolling-wm ~/.config/rift ~/.config/aerospace ~/.config/borders ~/.config/aegis ~/.config/ghostty; do
	if [ -d "$dir" ]; then
		mv "$dir" "$BACKUP_DIR/"
		ok "Moved $dir → $BACKUP_DIR/$(basename "$dir")"
	else
		warn "$dir not found — skipping"
	fi
done

# Legacy single-file/state locations for Paneru
for f in ~/.paneru ~/.paneru.toml "$HOME/.local/state/paneru"; do
	if [ -e "$f" ]; then
		mv "$f" "$BACKUP_DIR/" 2>/dev/null && ok "Moved $f → $BACKUP_DIR/" || warn "$f not found — skipping"
	fi
done

# Clean up backup dir if nothing was moved
if [ -z "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
	rmdir "$BACKUP_DIR" 2>/dev/null || true
fi

# ─────────────────────────────────────────────────────────────
# 4. Remove Aegis.app + preferences
# ─────────────────────────────────────────────────────────────
if [ -d /Applications/Aegis.app ]; then
	rm -rf /Applications/Aegis.app
	ok "Removed /Applications/Aegis.app"
else
	warn "/Applications/Aegis.app not found — skipping"
fi
if defaults read com.aegis.Aegis >/dev/null 2>&1; then
	defaults delete com.aegis.Aegis 2>/dev/null || true
	ok "Deleted Aegis preferences"
fi

# ─────────────────────────────────────────────────────────────
# 5. Uninstall brew packages + untaps (interactive keep menu)
# ─────────────────────────────────────────────────────────────
if command -v brew >/dev/null 2>&1; then
	echo ""
	note "Reviewing installed brew packages..."

	# Installed-package catalog: name, type, originating tap (if any)
	declare -a pkg_names pkg_types pkg_taps
	n=0
	add_pkg() {
		local name="$1" type="$2" tap="${3:-}"
		if brew list --"$type" "$name" >/dev/null 2>&1; then
			pkg_names[$n]="$name"
			pkg_types[$n]="$type"
			pkg_taps[$n]="$tap"
			n=$(( n + 1 ))
		fi
	}

	add_pkg rift        formula acsandmann/tap
	add_pkg borders     formula FelixKratz/formulae
	add_pkg paneru       formula              # legacy
	add_pkg aerospace    cask    nikitabobko/tap      # legacy
	add_pkg aerospacebar cask    rdrkr/tap            # legacy
	add_pkg tccutil-rs   formula uinaf/tap
	add_pkg ghostty      cask

	if [ "$n" -eq 0 ]; then
		warn "No packages from this setup are installed — nothing to uninstall."
	else
		echo ""
		echo "  Installed packages from this setup:"
		i=0
		while [ "$i" -lt "$n" ]; do
			echo "    [$(( i + 1 ))] ${pkg_names[$i]}"
			i=$(( i + 1 ))
		done
		echo ""
		echo "  Enter the numbers you want to KEEP (space-separated,"
		read -r -p '  e.g. "1 2"), or press Enter to remove all: ' keep_answer

		# Normalize the answer into a guarded space-delimited set: " 1 3 "
		keep_set=""
		for num in ${keep_answer:-}; do
			case "$num" in
				''|*[!0-9]*) continue ;;
			esac
			if [ "$num" -ge 1 ] && [ "$num" -le "$n" ]; then
				keep_set="$keep_set $num"
			fi
		done
		keep_set=" $keep_set "

		echo ""
		i=0
		remove_taps=""
		while [ "$i" -lt "$n" ]; do
			num=$(( i + 1 ))
			name="${pkg_names[$i]}"
			type="${pkg_types[$i]}"
			tap="${pkg_taps[$i]}"
			if [[ " $keep_set " == *" $num "* ]]; then
				ok "Keeping $name"
			else
				if brew uninstall --"$type" "$name" >/dev/null 2>&1; then
					ok "Uninstalled $name"
				else
					warn "$name could not be uninstalled (best-effort)"
				fi
				if [ -n "$tap" ]; then
					case "$remove_taps" in
						*" $tap "*) ;;
						*) remove_taps="$remove_taps $tap " ;;
					esac
				fi
			fi
			i=$(( i + 1 ))
		done

		# Only untap repos whose packages were actually removed
		if [ -n "$remove_taps" ]; then
			for tap in $remove_taps; do
				brew untap "$tap" >/dev/null 2>&1 || true
				brew untrust "$tap" >/dev/null 2>&1 || true
			done
			ok "Brew taps removed (best-effort)"
		fi
	fi
else
	warn "brew not found — skipping package removal"
fi

# ─────────────────────────────────────────────────────────────
# 6. Revert system defaults
# ─────────────────────────────────────────────────────────────
echo ""
note "Reverting system defaults..."

# Show the native menu bar again (Aegis is gone)
defaults write NSGlobalDomain _HIHideMenuBar -bool false 2>/dev/null || true

# Leave "Displays have separate Spaces" enabled (macOS default).
defaults write com.apple.spaces "spans-displays" -bool false 2>/dev/null || true
ok "System defaults reverted"

killall SystemUIServer 2>/dev/null || true
killall Finder 2>/dev/null || true

# ─────────────────────────────────────────────────────────────
# Summary
# ─────────────────────────────────────────────────────────────
echo ""
echo "  ${GREEN}══════════════════════════════════════════════════${RESET}"
echo "  ${GREEN}  Uninstall complete.${RESET}"
echo "  ${GREEN}══════════════════════════════════════════════════${RESET}"
echo ""
warn "A logout/login is advised for settings to fully revert."
echo ""
if [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
	echo "  Configs backed up at: $BACKUP_DIR"
	echo "  (copy back to ~/.config to restore)"
fi